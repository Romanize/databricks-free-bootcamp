# Copy to .env for LOCAL development only. Never commit a filled-in .env.
#
# The weather APIs need no credentials. LAKEBASE_URL is the one real secret in
# this homework, and it is only used to log tool calls for the dashboard app -
# leave it unset and the MCP server runs fine with logging switched off.
#
# When deployed, LAKEBASE_URL is NOT set: the app reads the URL from this
# homework's own secret scope, configured in app.yaml (homework-3/lakebase-url)
# and created by ../setup_secrets.py.
LAKEBASE_URL=postgresql://<role>:<password>@<your-instance>.database.cloud.databricks.com:5432/databricks_postgres?sslmode=require

# Set to 0 to skip tool-call logging entirely (no database needed).
WEATHER_LOG_TOOL_CALLS=1

# Sent as the User-Agent header; api.weather.gov asks for a contact address.
WEATHER_USER_AGENT=databricks-free-bootcamp-hw3 (you@example.com)

# "imperial" (F/mph/inch) or "metric" (C/kmh/mm)
WEATHER_DEFAULT_UNITS=imperial

# HTTP timeout in seconds for upstream weather calls
WEATHER_HTTP_TIMEOUT=20

# Endpoint overrides, only useful for testing against a mock
# OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast
# GEOCODE_API_URL=https://geocoding-api.open-meteo.com/v1/search
# NWS_API_BASE_URL=https://api.weather.gov
