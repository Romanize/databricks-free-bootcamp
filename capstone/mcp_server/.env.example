# Local development only. Never commit a filled-in copy - .env is gitignored.
# In Databricks Apps every one of these comes from app.yaml or the secret scope.

# Two Lakebase databases (local: two Postgres databases with pgvector).
LAKEBASE_URL=postgresql://user:password@localhost:5432/capstone?sslmode=disable
LAKEBASE_TRACING_URL=postgresql://user:password@localhost:5432/capstone_tracing?sslmode=disable

# Massive (https://massive.com/dashboard/keys). Free tier: 5 requests/minute.
MASSIVE_API_KEY=

# Alpaca PAPER keys (https://app.alpaca.markets/paper/dashboard/overview).
ALPACA_API_KEY_ID=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CAPSTONE_TRACING=1
