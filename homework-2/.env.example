# Copy to .env for LOCAL development only. Never commit a filled-in .env.
#
# When deployed as a Databricks App, LAKEBASE_URL is NOT set: the app reads the
# connection URL from this homework's own Databricks secret scope, configured
# in app.yaml (homework-2/lakebase-url) and created by setup_secrets.py.
LAKEBASE_URL=postgresql://<role>:<password>@<your-instance>.database.cloud.databricks.com:5432/databricks_postgres?sslmode=require

# NWS requires a descriptive User-Agent with a contact address.
WEATHER_USER_AGENT=databricks-free-bootcamp-hw2 (you@example.com)

# Optional overrides
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# CHUNK_SIZE=800
# CHUNK_OVERLAP=100
# WEATHER_SUMMARY_ENDPOINT=databricks-meta-llama-3-3-70b-instruct
