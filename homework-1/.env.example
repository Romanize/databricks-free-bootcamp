# Copy to .env for LOCAL development only. Never commit a filled-in .env.
#
# When deployed as a Databricks App, LAKEBASE_URL is NOT set: the app reads the
# connection URL from the Databricks secret scope configured in app.yaml
# (database/lakebase-url).
LAKEBASE_URL=postgresql://<role>:<password>@<your-instance>.database.cloud.databricks.com:5432/databricks_postgres?sslmode=require
